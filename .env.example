# Copy this file to `.env` and fill in what you have. `.env` is never committed.
#   cp .env.example .env

# ---- Voice (speech to text) -------------------------------------------------
# Needed ONLY for the microphone. Without it the app still starts and everything
# except voice works. Get a key from https://www.sarvam.ai
SARVAM_API_KEY=

# ---- Local language model ---------------------------------------------------
# The app calls a model through Ollama at http://localhost:11434
# (install Ollama, then:  ollama pull qwen2.5:3b-instruct).
# Where the model runs: 0 = CPU (the default), auto = let Ollama pick (GPU on
# most Apple-silicon Macs). Try both and keep the faster one:
#   PYTHONPATH=. .venv/bin/python scripts/bench_ollama.py
# CLINIC_LLM_NUM_GPU=auto
# INTENT_LLM_ENABLED=1        # 0 = keyword rules only (no model; less flexible)

# ---- App --------------------------------------------------------------------
# PORT=5050
# CLINIC_DB_PATH=clinic.db
# FLASK_SECRET_KEY=change-me

# ---- WhatsApp (optional; leave everything below blank for a demo) ------------
# With no credentials the app only RECORDS the messages it would have sent.
WHATSAPP_NOTIFY_MODE=dry_run
WHATSAPP_AGENT_ENABLED=0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# ---- Google Calendar sync (optional; leave blank for a demo) -----------------
# GOOGLE_SERVICE_ACCOUNT_FILE=/full/path/to/service-account.json
# GOOGLE_CALENDAR_ID=you@example.com
