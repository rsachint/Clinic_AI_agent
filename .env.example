# Copy this file to `.env` and fill in what you have. `.env` is never committed.
#   cp .env.example .env

# ---- Voice (speech to text) -------------------------------------------------
# Needed ONLY for the microphone. Without it the app still starts and everything
# except voice works. Get a key from https://www.sarvam.ai
SARVAM_API_KEY=

# ---- Local language model ---------------------------------------------------
# The app calls a model through Ollama at http://localhost:11434
# (install Ollama, then:  ollama pull gemma4:12b  -- about 8 GB).
# ONE model does everything (planner, command labels, names), so Ollama never
# swaps models. Change it with CLINIC_LLM_MODEL; PLANNER_MODEL changes only the
# planner (not advised: two big models do not fit in 16 GB).
# CLINIC_LLM_MODEL=gemma4:12b
# Where the model runs: 0 = CPU (the default), auto = let Ollama pick (GPU on
# most Apple-silicon Macs). Try both and keep the faster one:
#   PYTHONPATH=. .venv/bin/python scripts/bench_ollama.py
# CLINIC_LLM_NUM_GPU=auto
# INTENT_LLM_ENABLED=1        # 0 = keyword rules only (no model; less flexible)
# The tool-calling planner (clinic/nlu/planner.py). On by default. 0 puts the app
# back to the one-word command picker with no other change.
# INTENT_PLANNER_ENABLED=1
# PLANNER_TIMEOUT_S=12        # after this the old command picker is used instead
# INTENT_PLANNER_SCOPE=all    # unmatched = ask the planner only when the keyword rules find nothing
# Run the planner on Sarvam's hosted model instead (uses SARVAM_API_KEY above). Staff commands then never
# touch the local model: if Sarvam is slow or down, the keyword rules decide. It sends the planner prompt
# (rules, tool schemas, calendar, branch and doctor names) and the spoken sentence; no patient records.
# local (default) or sarvam. Settings shows this month's estimated spend.
# PLANNER_BACKEND=sarvam
# SARVAM_TIMEOUT_S=5          # the whole Sarvam call, retry included

# ---- App --------------------------------------------------------------------
# The sidebar's connection chip makes a bare TCP connect to Sarvam and WhatsApp (no TLS, no data) once a minute
# to notice patchy internet. 0 turns that idle check off (real calls are still counted).
# NETWORK_PROBE_ENABLED=1
# PORT=5050
# CLINIC_DB_PATH=clinic.db
# FLASK_SECRET_KEY=change-me

# ---- WhatsApp (optional; leave everything below blank for a demo) ------------
# With no credentials the app only RECORDS the messages it would have sent.
WHATSAPP_NOTIFY_MODE=dry_run
WHATSAPP_AGENT_ENABLED=0
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# ---- Google Calendar sync (optional; leave blank for a demo) -----------------
# Off by default: the in-app calendar (Appointments tab) is the calendar.
# GOOGLE_CALENDAR_SYNC=1
# GOOGLE_SERVICE_ACCOUNT_FILE=/full/path/to/service-account.json
# GOOGLE_CALENDAR_ID=you@example.com

# How staff commands are understood: model_reads (the default: the model also writes the read queries), model_first
# or classic (rules first). The Settings switch
# (app_settings key intent_architecture) wins; this is only the fallback when it has never been set.
# INTENT_ARCHITECTURE=classic
