{
  "templates": [
    {
      "name": "followup_reminder_2d_en",
      "category": "UTILITY",
      "language": "en",
      "written_in": "English",
      "reminder": "2 days before the follow-up date",
      "components": {
        "body": {
          "text": "Hello {{1}}, this is a reminder from the clinic about your follow-up visit with {{2}} at {{3}} on {{4}} at {{5}}. If your plans have changed, please tap a button below.",
          "variables": [
            "{{1}} = patient name",
            "{{2}} = doctor name",
            "{{3}} = branch",
            "{{4}} = follow-up date",
            "{{5}} = follow-up time"
          ],
          "example": [
            "Sunita Devi",
            "Dr. Mehta",
            "Branch A",
            "Monday, 12 Oct 2026",
            "10:30 AM"
          ]
        },
        "footer": {
          "text": "Reply STOP to stop these reminders"
        },
        "buttons": [
          {
            "type": "QUICK_REPLY",
            "text": "Reschedule",
            "payload_sent_with_each_message": "followup:reschedule:<follow-up id>"
          },
          {
            "type": "QUICK_REPLY",
            "text": "Already visited",
            "payload_sent_with_each_message": "followup:visited:<follow-up id>"
          },
          {
            "type": "QUICK_REPLY",
            "text": "Cancel",
            "payload_sent_with_each_message": "followup:cancel:<follow-up id>"
          }
        ]
      }
    },
